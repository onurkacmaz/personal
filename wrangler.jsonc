{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal",
  "compatibility_date": "2026-09-05",

  // The login has access to more than one account, so pin the target
  // explicitly instead of leaving the choice to a prompt.
  "account_id": "e663e3d933363fff9f6408fabad8db0d",

  // The Worker serves the static assets and answers one API route, the Togul
  // blog-flag evaluation. run_worker_first sends only that route to the
  // script; every other request is answered straight from the assets.
  // The key is the TOGUL_SDK_KEY secret (dashboard, or `wrangler secret put`).
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/v1/*"],
    // Without this, an unmatched path returns a 404 with an empty body.
    "not_found_handling": "404-page"
  },

  // Declaring routes makes wrangler default workers_dev to false, which takes
  // the *.workers.dev URL offline. Keep it explicit so that cannot happen.
  "workers_dev": true,
  "preview_urls": true,

  // custom_domain (rather than a plain route) lets Cloudflare create the DNS
  // record and issue the certificate itself. A plain route would need a DNS
  // record to already exist.
  "routes": [
    { "pattern": "onurkacmaz.com", "custom_domain": true },
    { "pattern": "www.onurkacmaz.com", "custom_domain": true }
  ]
}
